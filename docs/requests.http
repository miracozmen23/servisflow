@baseUrl = http://localhost:3001/api

### Health
GET {{baseUrl}}/health
Accept: application/json

### Register a customer and start a session
# @name register
# @prompt email Customer email address
# @prompt password Customer password (12-72 characters, not stored)
# @prompt firstName Customer first name
# @prompt lastName Customer last name
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "firstName": "{{firstName}}",
  "lastName": "{{lastName}}"
}

### Login and store the session cookie in REST Client's cookie jar
# @name login
# @prompt email Account email address
# @prompt password Account password (not stored)
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Get the current user using the stored session cookie
GET {{baseUrl}}/auth/me
Accept: application/json

### Create a service request (requires an active CUSTOMER session)
# @name createServiceRequest
# @prompt brand Product brand
# @prompt model Product model
# @prompt serialNumber Product serial number
# @prompt invoiceNumber Invoice number
# @prompt purchaseDate Purchase date (YYYY-MM-DD)
# @prompt problemDescription Problem description (10-2000 characters)
POST {{baseUrl}}/service-requests
Content-Type: application/json
Accept: application/json

{
  "brand": "{{brand}}",
  "model": "{{model}}",
  "serialNumber": "{{serialNumber}}",
  "invoiceNumber": "{{invoiceNumber}}",
  "purchaseDate": "{{purchaseDate}}",
  "problemDescription": "{{problemDescription}}"
}

### List requests visible to the current account
GET {{baseUrl}}/service-requests?page=1&limit=20
Accept: application/json

### Filter requests by status and search RMA or serial number
# @prompt status Service status, for example DIAGNOSIS
# @prompt search RMA number or serial number fragment
GET {{baseUrl}}/service-requests?page=1&limit=20&status={{status}}&search={{search}}
Accept: application/json

### Get a request detail (the response is projected for the current role)
# @prompt requestId Service request UUID
GET {{baseUrl}}/service-requests/{{requestId}}
Accept: application/json

### Change request status (requires a TECHNICIAN session)
# Run the login request above with the seeded technician account first.
# Valid path: WARRANTY_APPROVED -> DEVICE_RECEIVED -> DIAGNOSIS -> REPAIR -> QUALITY_CONTROL -> CLOSED
# DIAGNOSIS may alternatively transition to NOT_REPAIRABLE.
# @prompt requestId Service request UUID
# @prompt nextStatus Next valid service status
# @prompt customerMessage Customer-visible status message (1-500 characters)
PATCH {{baseUrl}}/service-requests/{{requestId}}/status
Content-Type: application/json
Accept: application/json

{
  "status": "{{nextStatus}}",
  "customerMessage": "{{customerMessage}}"
}

### Close or mark a request not repairable (requires a TECHNICIAN session)
# Use CLOSED or NOT_REPAIRABLE only when it is a valid next status.
# @prompt requestId Service request UUID
# @prompt terminalStatus CLOSED or NOT_REPAIRABLE
# @prompt resolutionSummary Customer-visible resolution (10-500 characters)
# @prompt customerMessage Customer-visible status message (1-500 characters)
PATCH {{baseUrl}}/service-requests/{{requestId}}/status
Content-Type: application/json
Accept: application/json

{
  "status": "{{terminalStatus}}",
  "resolutionSummary": "{{resolutionSummary}}",
  "customerMessage": "{{customerMessage}}"
}

### Add an internal note (requires a TECHNICIAN session)
# The note and NOTE_ADDED event are never returned to a customer.
# @prompt requestId Service request UUID
# @prompt note Internal technician note (2-2000 characters)
POST {{baseUrl}}/service-requests/{{requestId}}/notes
Content-Type: application/json
Accept: application/json

{
  "content": "{{note}}"
}

### Revoke the current session and clear its cookie
POST {{baseUrl}}/auth/logout
Accept: application/json

### Confirm that the revoked session is rejected
GET {{baseUrl}}/auth/me
Accept: application/json
