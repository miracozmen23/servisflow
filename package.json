{
  "name": "servisflow",
  "version": "0.1.0",
  "private": true,
  "description": "Warranty-aware RMA service request platform.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@servisflow/web",
    "dev:api": "npm run start:dev --workspace=@servisflow/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "prisma": false,
    "@prisma/engines": false,
    "esbuild": false,
    "@scarf/scarf": false
  }
}
